# ============================================================
#  MCP PHP CRUD Server - configuracion (copie a .env y edite)
#  NUNCA suba el archivo .env al repositorio.
# ============================================================

# production | local | testing   (en production: HTTPS obligatorio, sin proveedor "dev")
APP_ENV=local

# Clave secreta del servidor (>= 32 caracteres) usada para el HMAC de los tokens personales.
# Genere con:  php bin/console app:generate-key
APP_KEY=

# URL publica base del servidor HTTP (sin barra final). Define el issuer OAuth y el recurso MCP (APP_URL/mcp).
APP_URL=http://localhost:8787

# ---- Base de datos (MySQL 8+ / MariaDB 10.6+) ---------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mcp_server
DB_USER=mcp_user
DB_PASSWORD=

# ---- Logs ----------------------------------------------------
LOG_PATH=storage/logs
LOG_LEVEL=info
SESSION_PATH=storage/sessions

# ---- Transporte STDIO ---------------------------------------
# Token personal del usuario que usara el cliente MCP:  php bin/console token:create --email=...
MCP_ACCESS_TOKEN=

# ---- Tokens personales --------------------------------------
TOKEN_MAX_TTL_DAYS=90
# Aceptar tokens personales (mcp_...) tambien en HTTP. NO es OAuth. Recomendado: false.
MCP_HTTP_ALLOW_PERSONAL_TOKENS=false

# ---- Transporte HTTP ----------------------------------------
# Hosts permitidos en la cabecera Host (proteccion contra DNS rebinding), separados por coma.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Origins permitidos para CORS (clientes MCP basados en navegador). Vacio = ninguno.
MCP_ALLOWED_ORIGINS=

# ---- OAuth 2.1 (servidor de autorizacion embebido) ----------
# Claves RSA para firmar JWT:  php bin/console oauth:keys
OAUTH_PRIVATE_KEY=storage/keys/private.pem
OAUTH_PUBLIC_KEY=storage/keys/public.pem
# Clave de cifrado de codigos de autorizacion y refresh tokens (php bin/console app:generate-key)
OAUTH_ENCRYPTION_KEY=
OAUTH_ACCESS_TOKEN_TTL=3600
OAUTH_REFRESH_TOKEN_TTL=2592000
OAUTH_AUTH_CODE_TTL=600
# Registro dinamico de clientes (RFC 7591) y tope por hora
OAUTH_DCR_ENABLED=true
OAUTH_DCR_MAX_PER_HOUR=60

# ---- Proveedor de identidad externo (quien es el usuario humano) ----
# google | microsoft | generic | dev  (dev SOLO desarrollo: formulario de correo, prohibido en production)
OAUTH_IDP=dev
OAUTH_IDP_CLIENT_ID=
OAUTH_IDP_CLIENT_SECRET=
# Solo para OAUTH_IDP=generic (Keycloak, Auth0, Okta...)
OAUTH_IDP_NAME=generic
OAUTH_IDP_AUTHORIZE_URL=
OAUTH_IDP_TOKEN_URL=
OAUTH_IDP_USERINFO_URL=
OAUTH_IDP_SCOPES="openid email profile"
