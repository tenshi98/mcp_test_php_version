{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "php-crud": {
        "type": "local",
        "command": ["php", "/RUTA/ABSOLUTA/mcp_test_php_version/bin/mcp-server"],
        "environment": {
          "APP_KEY": "{env:MCP_APP_KEY}",
          "DB_HOST": "127.0.0.1",
          "DB_PORT": "3306",
          "DB_NAME": "mcp_server",
          "DB_USER": "mcp_user",
          "DB_PASSWORD": "{env:MCP_DB_PASSWORD}",
          "MCP_ACCESS_TOKEN": "{env:MCP_ACCESS_TOKEN}"
        }
      }
    }
  }
}
